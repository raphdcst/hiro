{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,

		// Decorators
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Some stricter flags (disabled by default)
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false,

		"outDir": "./dist",
		"rootDir": ".",

		"paths": {
			"hiro": ["./packages/hiro/src/client"],
			"hiro/*": ["./packages/hiro/src/*"],
			"#core/*": ["./packages/hiro/src/core/*"],
			"#managers/*": ["./packages/hiro/src/core/managers/*"],
			"#interfaces/*": ["./packages/hiro/src/interfaces/*"],
			"@hiro/services": ["./packages/services/src/index"],
			"@hiro/plugins": ["./packages/plugins/src/index"],
			"@hiro/commands": ["./packages/commands/src/index"],
			"#middlewares/*": ["./packages/hiro/src/middlewares/*"],
			"#utils/*": ["./packages/hiro/src/utils/*"]
		}
	},
	"include": ["src/**/*", "packages/**/*"],
	"exclude": ["node_modules", "dist"]
}
